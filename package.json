{
  "name": "@ryn-mic/dsh-qq",
  "version": "0.1.1",
  "icon": "./assets/logo-plugin-message-link-gradient.webp",
  "description": "A personal QQ-only plugin for DeepSeek Harness, forked from xmanrui/dsh-im.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qq",
    "chatbot"
  ],
  "author": "xmanrui (https://github.com/xmanrui)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryn-Mic/dsh-qq.git"
  },
  "homepage": "https://github.com/Ryn-Mic/dsh-qq#readme",
  "bugs": {
    "url": "https://github.com/Ryn-Mic/dsh-qq/issues"
  },
  "bin": {
    "dsh-qq": "bin/dsh-qq.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "assets/logo-plugin-message-link-gradient.webp",
    "bin",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "plugin-src",
    "src",
    "scripts/verify-package.mjs",
    "PROACTIVE_DELIVERY.md",
    "PROACTIVE_DELIVERY.en.md",
    "docs/client-integration.md",
    "docs/preset-workspaces.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md",
    "QQ_EXTENSIONS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "load-smoke-pending"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "build": "node plugin-src/client/build.mjs && node plugin-src/host/build.mjs",
    "test": "node --test test/*.test.mjs test/channels/qq/*.test.mjs test/channels/shared/*.test.mjs",
    "check": "npm run build && npm test && node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "esbuild": "0.25.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  },
  "private": true
}
